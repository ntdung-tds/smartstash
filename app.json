{
  "expo": {
    "name": "SmartStash",
    "slug": "smartstash-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smartstash",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.smartstash.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E7C66",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SmartStash cần truy cập thư viện ảnh để bạn chọn ảnh món đồ và ảnh hiện trường.",
          "cameraPermission": "SmartStash cần camera để chụp ảnh món đồ, ảnh hiện trường và quét mã QR."
        }
      ],
      "expo-notifications",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép SmartStash dùng camera để quét mã QR và barcode.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}